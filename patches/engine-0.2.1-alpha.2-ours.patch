+/** Estimated per-Turn charge, seated beside the Turn-usage pill. */
+
+import type { TurnTokenUsage } from '../contract/chat-nodes.ts'
+import type { ChatViewSlotProps } from '../contract/slots.ts'
+import { estimateTurnCost, formatTurnCost } from './turn-cost.ts'
+import css from './TurnUsagePanel.module.css'
+
+export interface TurnCostPillProps {
+  readonly usage: TurnTokenUsage
+  /** This Turn's tail time, which picks the peak/off-peak rate. */
+  readonly time: number
+  /** Billed server-side search calls in this Turn. */
+  readonly searches?: number
+  /** The owning view's locale seat, passed down as a plain prop. */
+  readonly t: ChatViewSlotProps['t']
+}
+
+/**
+ * Reading-only charge pill: nothing to open, so it carries no hover
+ * affordance and no dialog.
+ * @param props - Turn usage, tail time, locale seat.
+ * @returns the pill, or null when the Turn cannot be priced.
+ */
+export function TurnCostPill({ usage, time, searches = 0, t }: TurnCostPillProps) {
+  const estimate = estimateTurnCost(usage, time, searches)
+  if (estimate === null) return null
+  return (
+    <span className={`${css.root} ${css.costRoot}`} data-turn-cost={estimate.peak ? 'peak' : 'off-peak'}>
+      <span className={css.cost} title={t('message.turnUsage.costHint')}>
+        <span className={css.label}>
+          {t('message.turnUsage.cost', { cost: formatTurnCost(estimate) })}
+        </span>
+      </span>
+    </span>
+  )
+}
