+/** Occupancy at which the meter starts warning; below it the ring keeps its neutral tone. */
+export const CONTEXT_WARN_PERCENT = 70
+
+/** Occupancy at which the meter reads fully critical. */
+export const CONTEXT_CRITICAL_PERCENT = 80
+
+/**
+ * Resolve the meter's tint at one occupancy. Amber from the warning floor
+ * blending into red by the critical mark, so the ring reads as a ramp instead of
+ * flipping state at a threshold — the automatic compaction that follows would
+ * otherwise arrive with no warning at all.
+ * @param percent - bounded display occupancy.
+ * @returns a themed color, or undefined to keep the meter's own neutral color.
+ */
+export function contextTint(percent: number): string | undefined {
+  if (percent < CONTEXT_WARN_PERCENT) return undefined
+  const ramp = Math.min(
+    1,
+    (percent - CONTEXT_WARN_PERCENT) / (CONTEXT_CRITICAL_PERCENT - CONTEXT_WARN_PERCENT),
+  )
+  return `color-mix(in srgb, var(--dsw-alias-state-error-primary) ${ramp * 100}%, `
+    + 'var(--dsw-alias-state-warn-primary))'
+}
