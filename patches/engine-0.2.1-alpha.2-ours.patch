+++ b/packages/client/ui-chat/src/client/chat/turn-cost.ts
@@ -0,0 +1,104 @@
+/**
+ * Turn cost estimate from provider-reported tokens and DeepSeek's published
+ * price table. There is no per-request billing API (the account balance
+ * endpoint is the only official money-related endpoint), so a turn's cost can
+ * only be priced locally: exact tokens × the published per-million rate.
+ *
+ * Prices are CNY per million tokens, copied from
+ * https://api-docs.deepseek.com/zh-cn/quick_start/pricing on 2026-10-21.
+ * When DeepSeek changes its table this constant is the one place to edit.
+ */
+
+import type { TurnTokenUsage } from '../contract/chat-nodes.ts'
+
+interface ModelRate {
+  /** Cached input (cache hit) tokens. */
+  readonly cacheRead: number
+  /** Uncached input (cache miss) tokens. */
+  readonly input: number
+  readonly output: number
+}
+
+interface ModelRates {
+  readonly peak: ModelRate
+  readonly offPeak: ModelRate
+}
+
+const RATES: Readonly<Record<string, ModelRates>> = {
+  'deepseek-flash': {
+    peak: { cacheRead: 0.04, input: 2, output: 8 },
+    offPeak: { cacheRead: 0.02, input: 1, output: 4 },
+  },
+  'deepseek-v4-pro': {
+    peak: { cacheRead: 0.3, input: 9, output: 27 },
+    offPeak: { cacheRead: 0.15, input: 4.5, output: 13.5 },
+  },
+}
+
+/** Retired names DeepSeek still accepts and still bills at Flash rates. */
+const ALIASES: Readonly<Record<string, string>> = {
+  'deepseek-v4-flash': 'deepseek-flash',
+  'deepseek-v4-flash-vision-exp': 'deepseek-flash',
+}
+
+const BEIJING_OFFSET_MS = 8 * 3_600_000
+
+/**
+ * Peak billing runs on Beijing-time weekdays 09:00–12:00 and 14:00–18:00.
+ * Chinese public holidays bill off-peak but no holiday calendar is available
+ * here, so their requests price as peak — an over-estimate of about 2× on
+ * those days, never an under-estimate.
+ * @param time - epoch ms of the request (this turn's tail).
+ * @returns whether peak rates apply.
+ */
+export function isPeakTime(time: number): boolean {
+  const beijing = new Date(time + BEIJING_OFFSET_MS)
+  const day = beijing.getUTCDay()
+  if (day === 0 || day === 6) return false
+  const hour = beijing.getUTCHours()
+  return (hour >= 9 && hour < 12) || (hour >= 14 && hour < 18)
+}
+
+export interface TurnCostEstimate {
+  /** Estimated charge in CNY. */
+  readonly cny: number
+  readonly peak: boolean
+}
+
+/**
+ * Price one Turn.
+ * @param usage - exact provider-reported buckets for the whole Turn.
+ * @param time - epoch ms used to pick the peak/off-peak rate.
+ * @returns the estimate, or null when the model is unknown to the table or the
+ * Turn mixes models (its tokens cannot be split across rates).
+ */
+export function estimateTurnCost(usage: TurnTokenUsage, time: number): TurnCostEstimate | null {
+  const routes = usage.routes
+  const first = routes?.[0]
+  if (routes === undefined || first === undefined) return null
+  const model = first.model
+  if (!routes.every(route => route.model === model)) return null
+  const rates = RATES[ALIASES[model] ?? model]
+  if (rates === undefined) return null
+  const peak = isPeakTime(time)
+  const rate = peak ? rates.peak : rates.offPeak
+  const cacheRead = usage.cacheReadTokens ?? 0
+  // Cache writes are billed as plain misses: DeepSeek reports no such bucket,
+  // but another provider on the same model would count toward input.
+  const input = usage.uncachedInputTokens + (usage.cacheWriteTokens ?? 0)
+  const cny = (cacheRead * rate.cacheRead + input * rate.input + usage.outputTokens * rate.output) / 1_000_000
+  return { cny, peak }
+}
+
+/**
+ * Round for display: cents are noise below ¥0.01, where four decimals keep the
+ * reading non-zero for short turns.
+ * @param estimate - priced Turn.
+ * @returns the amount without a currency mark.
+ */
+export function formatTurnCost(estimate: TurnCostEstimate): string {
+  const value = estimate.cny
+  if (value >= 0.01) return value.toFixed(2)
+  if (value >= 0.0001) return value.toFixed(4)
+  return '<0.0001'
+}
