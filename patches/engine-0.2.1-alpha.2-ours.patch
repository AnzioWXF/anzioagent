+/**
+ * Composer layout a host may declare.
+ *
+ * A host that replaces the frame root (a desktop shell embedding this
+ * conversation surface — an IDE that owns its own workspace and session
+ * chrome) owns the arrangement of the new-session controls. The shipped
+ * layout puts the workspace picker and the agent-preset chip in a row above
+ * the composer card; a host whose workspace surface lives elsewhere can ask
+ * for that row to be dropped and for the preset control to ride inside the
+ * card's tool row instead.
+ *
+ * Read at render time from a process-wide global, so a host can declare it
+ * before the surface mounts. Absent → the shipped arrangement, untouched.
+ */
+
+/** The host's composer-layout declaration. */
+export interface HostComposerLayout {
+  /**
+   * Render the new-session agent-preset control inside the composer tool row
+   * and drop the hero's workspace/preset row entirely.
+   */
+  readonly presetInToolRow?: boolean
+}
+
+/**
+ * Read the host's declaration.
+ * @returns the declared layout, or an empty object when the host made none.
+ */
+export function hostComposerLayout(): HostComposerLayout {
+  const declared = (globalThis as { __DSH_HOST_COMPOSER__?: HostComposerLayout }).__DSH_HOST_COMPOSER__
+  return declared ?? {}
+}
