diff --git a/apps/desktop/src/tiangong-home.ts b/apps/desktop/src/tiangong-home.ts
new file mode 100644
index 0000000000..f47953198f
--- /dev/null
+++ b/apps/desktop/src/tiangong-home.ts
@@ -0,0 +1,48 @@
+/**
+ * 天工的家目录（自研，官方源码只在 main.ts 的 import 处接入）。
+ *
+ * 为什么必须独立：官方默认家目录 `~/.dsh` 是 **dsh 命令行的**家 —— 同一份 `profiles`、
+ * 同一份凭证、同一套会话。天工塞进去会和命令行互相覆盖（两边各自装插件、各自升级）。
+ * 天工是独立产品：程序在安装目录，数据在自己的家目录，卸载不留垃圾、备份拷一个目录就行。
+ *
+ * 取值优先级（最高到最低）：
+ *   1. 环境变量 `TIANGONG_HOME`
+ *   2. exe 旁边的 `tiangong-home.txt`（一行纯文本；装机脚本/绿色版改这一个文件即可，
+ *      不必碰系统环境变量）
+ *   3. 打包版默认 `%LOCALAPPDATA%\Tiangong\home`
+ *   4. 开发模式：不设（沿用官方开发期家目录 `.desktop-build\development\home`）
+ *
+ * ⚠ 必须在 `resolveDesktopPaths()` / 任何 `resolveDshHome()` 调用之前执行 ——
+ * 官方各处都是"调用时读 process.env"，所以这里在模块顶层定好即可。
+ */
+
+import { app } from 'electron'
+import { existsSync, readFileSync } from 'node:fs'
+import { dirname, join, resolve } from 'node:path'
+
+export function resolveTiangongHome(): string | undefined {
+  const configured = process.env.TIANGONG_HOME
+  if (configured !== undefined && configured.trim() !== '') return resolve(configured.trim())
+
+  if (app.isPackaged) {
+    const pointer = join(dirname(process.execPath), 'tiangong-home.txt')
+    if (existsSync(pointer)) {
+      try {
+        const line = (readFileSync(pointer, 'utf8').split(/\r?\n/u)[0] ?? '').trim()
+        if (line !== '') return resolve(line)
+      } catch { /* 读不了就当没配 */ }
+    }
+    const local = process.env.LOCALAPPDATA
+    if (local !== undefined && local.trim() !== '') return join(local, 'Tiangong', 'home')
+    return join(app.getPath('home'), 'Tiangong', 'home')
+  }
+  return undefined
+}
+
+/** 把天工家目录写进 `DSH_HOME`；开发模式返回 undefined 表示不改。 */
+export function applyTiangongHome(): string | undefined {
+  const home = resolveTiangongHome()
+  if (home === undefined) return undefined
+  process.env.DSH_HOME = home
+  return home
+}
diff --git a/apps/desktop/src/tiangong-ipc.ts b/apps/desktop/src/tiangong-ipc.ts
new file mode 100644
index 0000000000..d2a8c7d764
--- /dev/null
+++ b/apps/desktop/src/tiangong-ipc.ts
@@ -0,0 +1,209 @@
+/**
+ * 天工壳能力主进程侧（自研，官方源码只在 main.ts 里 import + 调用处接入）。
+ *
+ * 这批 handler 在天工旧壳 `shell/main.js` 里都有对应实现；官方桌面壳没有它们，
+ * 插件那边是按单项能力探测的（`anzioShell.pickFile` 不存在就提示"当前环境不支持"）。
+ * 页面侧的暴露见 `tiangong-preload.ts`，两处必须成对增删。
+ *
+ * 密钥文件落在**官方家目录**（resolveDshHome），与插件看到的 profile 同一个家；
+ * 家目录口径（app-home 整体迁 vs 并行）还没拍板之前，用户旧存的 SSH 口令在新壳里读不到。
+ */
+
+import { BrowserWindow, dialog, globalShortcut, ipcMain, safeStorage, shell } from 'electron'
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { resolveDshHome } from '@deepseek-ai/dsh-home-paths'
+
+type Note = (level: 'info' | 'warn' | 'error', kind: string, message: string, meta?: unknown) => void
+
+let handlersInstalled = false
+/** 当前主窗口：hotkeys 条目在窗口重建后仍指向活着的那个（handler 只注册一次）。 */
+let activeWindow: BrowserWindow | undefined
+
+function parentOf(event: Electron.IpcMainInvokeEvent): BrowserWindow | undefined {
+  return BrowserWindow.fromWebContents(event.sender) ?? undefined
+}
+
+function openDialog(parent: BrowserWindow | undefined, options: Electron.OpenDialogOptions): Promise<Electron.OpenDialogReturnValue> {
+  return parent === undefined ? dialog.showOpenDialog(options) : dialog.showOpenDialog(parent, options)
+}
+
+function saveDialog(parent: BrowserWindow | undefined, options: Electron.SaveDialogOptions): Promise<Electron.SaveDialogReturnValue> {
+  return parent === undefined ? dialog.showSaveDialog(options) : dialog.showSaveDialog(parent, options)
+}
+
+function installHandlers(note: Note): void {
+  ipcMain.handle('anzio-shell:reveal', (_event, target) => {
+    try {
+      if (typeof target !== 'string' || !target) return { ok: false, code: 'bad-arg' }
+      if (!existsSync(target)) return { ok: false, code: 'not-found' }
+      shell.showItemInFolder(target)
+      return { ok: true }
+    } catch (error) {
+      return { ok: false, code: 'error', message: String((error as Error)?.message ?? error) }
+    }
+  })
+
+  ipcMain.handle('anzio-shell:pick-file', async event => {
+    try {
+      const result = await openDialog(parentOf(event), { title: '打开文件', properties: ['openFile', 'dontAddToRecent'] })
+      if (result.canceled || result.filePaths.length === 0) return { ok: false, code: 'canceled' }
+      return { ok: true, path: result.filePaths[0] }
+    } catch (error) {
+      return { ok: false, code: 'error', message: String((error as Error)?.message ?? error) }
+    }
+  })
+
+  ipcMain.handle('anzio-shell:pick-save', async (event, defaultPath) => {
+    try {
+      const options: Electron.SaveDialogOptions = { title: '另存为', properties: ['showOverwriteConfirmation', 'dontAddToRecent'] }
+      if (typeof defaultPath === 'string' && defaultPath) options.defaultPath = defaultPath
+      const result = await saveDialog(parentOf(event), options)
+      if (result.canceled || !result.filePath) return { ok: false, code: 'canceled' }
+      return { ok: true, path: result.filePath }
+    } catch (error) {
+      return { ok: false, code: 'error', message: String((error as Error)?.message ?? error) }
+    }
+  })
+
+  ipcMain.handle('anzio-shell:pick-dir', async event => {
+    try {
+      const result = await openDialog(parentOf(event), {
+        title: '选择保存目录',
+        properties: ['openDirectory', 'createDirectory', 'dontAddToRecent'],
+      })
+      if (result.canceled || result.filePaths.length === 0) return { ok: false, code: 'canceled' }
+      return { ok: true, path: result.filePaths[0] }
+    } catch (error) {
+      return { ok: false, code: 'error', message: String((error as Error)?.message ?? error) }
+    }
+  })
+
+  const secretPath = join(resolveDshHome(), 'secrets.json')
+  const readSecrets = (): Record<string, string> => {
+    try {
+      const parsed: unknown = JSON.parse(readFileSync(secretPath, 'utf8'))
+      return parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed as Record<string, string> : {}
+    } catch { return {} }
+  }
+  const writeSecrets = (map: Record<string, string>): boolean => {
+    try {
+      mkdirSync(dirname(secretPath), { recursive: true })
+      writeFileSync(secretPath, JSON.stringify(map, null, 2), { encoding: 'utf8', mode: 0o600 })
+      return true
+    } catch (error) {
+      note('error', 'secret', 'write-failed', { message: String((error as Error)?.message ?? error) })
+      return false
+    }
+  }
+  const encryptionReady = (): boolean => {
+    try { return safeStorage.isEncryptionAvailable() } catch { return false }
+  }
+
+  ipcMain.handle('anzio-shell:secret-set', (_event, key, value) => {
+    try {
+      const name = String(key || '').slice(0, 120)
+      const secret = String(value || '')
+      if (!name || !secret) return { ok: false, code: 'bad-arg' }
+      if (!encryptionReady()) return { ok: false, code: 'no-encryption' }
+      const map = readSecrets()
+      map[name] = safeStorage.encryptString(secret).toString('base64')
+      return writeSecrets(map) ? { ok: true } : { ok: false, code: 'write-failed' }
+    } catch (error) {
+      note('error', 'secret', 'set-failed', { message: String((error as Error)?.message ?? error) })
+      return { ok: false, code: 'error' }
+    }
+  })
+
+  ipcMain.handle('anzio-shell:secret-get', (_event, key) => {
+    try {
+      const name = String(key || '').slice(0, 120)
+      if (!name) return { ok: false, code: 'bad-arg' }
+      const stored = readSecrets()[name]
+      if (stored === undefined) return { ok: false, code: 'not-found' }
+      if (!encryptionReady()) return { ok: false, code: 'no-encryption' }
+      return { ok: true, value: safeStorage.decryptString(Buffer.from(stored, 'base64')) }
+    } catch (error) {
+      // 换过 Windows 账户 / 文件来自别的机器 / 密文损坏 —— 一律当"没存过"，让插件走重新填写
+      note('warn', 'secret', 'get-failed', { message: String((error as Error)?.message ?? error) })
+      return { ok: false, code: 'decrypt-failed' }
+    }
+  })
+
+  ipcMain.handle('anzio-shell:secret-del', (_event, key) => {
+    try {
+      const name = String(key || '').slice(0, 120)
+      if (!name) return { ok: false, code: 'bad-arg' }
+      const map = readSecrets()
+      if (map[name] !== undefined) {
+        delete map[name]
+        writeSecrets(map)
+      }
+      return { ok: true }
+    } catch { return { ok: false, code: 'error' } }
+  })
+
+  ipcMain.handle('anzio-shell:hotkeys', (_event, list) => {
+    pageChords = (Array.isArray(list) ? list : []).filter(item => typeof item === 'string' && !String(item).includes(' ')).slice(0, 80)
+    if (activeWindow !== undefined && activeWindow.isFocused()) { unregisterAllHotkeys(); registerAllHotkeys(note) }
+    return { ok: true, count: pageChords.length }
+  })
+}
+
+/**
+ * 天工快捷键最高优先（core.md §2）：页面把键位表交上来，壳**只在窗口有焦点时**
+ * 注册成全局快捷键并在失焦时全部注销 —— 绝不在别的程序里抢这些键。
+ */
+const DEFAULT_ACCELERATOR = 'Control+`'
+const DEFAULT_CHORD = 'Ctrl+`'
+let pageChords: string[] = []
+
+function unregisterAllHotkeys(): void {
+  try { globalShortcut.unregisterAll() } catch { /* 忽略 */ }
+}
+
+function registerAllHotkeys(note: Note): void {
+  const window = activeWindow
+  if (!window || window.isDestroyed()) return
+  const entries: [string, string][] = [[DEFAULT_ACCELERATOR, DEFAULT_CHORD]]
+  for (const chord of pageChords) entries.push([chord, chord])
+  for (const [accelerator, chord] of entries) {
+    try {
+      if (globalShortcut.isRegistered(accelerator)) continue
+      if (!globalShortcut.register(accelerator, () => {
+        try { window.webContents.send('anzio-shell:hotkey', chord) } catch { /* 窗口没了 */ }
+      })) {
+        note('warn', 'hotkey', '全局快捷键注册失败（被系统/其它程序占用）', { accelerator })
+      }
+    } catch (error) {
+      note('error', 'hotkey', '全局快捷键注册异常', { accelerator, message: String((error as Error)?.message ?? error) })
+    }
+  }
+}
+
+function attachHotkeyForwarding(window: BrowserWindow, note: Note): void {
+  activeWindow = window
+  window.on('focus', () => { unregisterAllHotkeys(); registerAllHotkeys(note) })
+  window.on('blur', unregisterAllHotkeys)
+  window.on('closed', () => {
+    if (activeWindow === window) activeWindow = undefined
+    unregisterAllHotkeys()
+  })
+  if (window.isFocused()) registerAllHotkeys(note)
+}
+
+/**
+ * 装天工壳能力：handler 只注册一次（重复注册会抛错），窗口相关的部分每次调用都挂。
+ * @param options - 主窗口与日志出口（日志直接进官方 stdout）。
+ */
+export function installTiangongIpc(options: { window: BrowserWindow; log: (message: string) => void }): void {
+  const note: Note = (level, kind, message, meta) => {
+    options.log(`[tiangong][${kind}] ${level} ${message}${meta === undefined ? '' : ' ' + JSON.stringify(meta)}`)
+  }
+  if (!handlersInstalled) {
+    handlersInstalled = true
+    installHandlers(note)
+    options.log('[tiangong][ipc] 壳能力 handler 已注册（reveal / pick-file / pick-save / pick-dir / secret-set|get|del）')
+  }
+  attachHotkeyForwarding(options.window, note)
+}
diff --git a/apps/desktop/src/tiangong-preload.ts b/apps/desktop/src/tiangong-preload.ts
new file mode 100644
index 0000000000..e469374669
--- /dev/null
+++ b/apps/desktop/src/tiangong-preload.ts
@@ -0,0 +1,89 @@
+/**
+ * 天工页面桥（自研，官方源码只在本文件被 import 那一行接入）。
+ *
+ * 为什么需要它：天工插件是**跑在官方页面里的**，它指挥内置浏览器、拿拖入文件的真实路径，
+ * 全靠旧壳 preload 暴露的 `window.anzioShell`。官方壳的 preload 没有这一项 ⇒ 插件退回
+ * "当前环境不支持"的降级路径。表现出来不是报错，而是原生视图永远拿不到矩形（宽高 0）：
+ * 点击落点算成 (1,1)、截图报 "Cannot take screenshot with 0 width"。
+ *
+ * 主进程侧的 `anzio-browser:*` handler 由 browser.js 的 installBrowserHost 一次性注册，
+ * 本文件只做页面侧的暴露，不改任何业务判断。插件按单项能力探测（`anzioShell.browser`、
+ * `anzioShell.getFilePath`），因此这里可以按组逐步放开，不会出现"看起来有能力、一调就炸"。
+ */
+
+import { contextBridge, ipcRenderer, webUtils } from 'electron'
+
+export function installTiangongPreload(): void {
+  // 更新器桥（旧壳同名）：插件读版本、查更新、装更新。开发模式与更新器初始化失败时
+  // 主进程不会注册这些通道，调用会 reject —— 插件靠 available 探测，不做兜底。
+  contextBridge.exposeInMainWorld('anzioUpdater', {
+    available: true,
+    getState: () => ipcRenderer.invoke('anzio-updater:state'),
+    check: () => ipcRenderer.invoke('anzio-updater:check'),
+    install: () => ipcRenderer.invoke('anzio-updater:install'),
+    applyAndRestart: () => ipcRenderer.invoke('anzio-updater:apply'),
+    // ⚠ 必须留：插件启动时就订阅状态（标题栏版本徽标靠它）。
+    // 少了这一个方法，插件在 root 槽里一调就抛 TypeError → 整页白屏，且日志只有一行 console.error。
+    onState: (callback: (state: unknown) => void) => {
+      const handler = (_event: Electron.IpcRendererEvent, state: unknown): void => { try { callback(state) } catch { /* 忽略 */ } }
+      ipcRenderer.on('anzio-updater:state', handler)
+      return () => { try { ipcRenderer.removeListener('anzio-updater:state', handler) } catch { /* 忽略 */ } }
+    },
+  })
+  contextBridge.exposeInMainWorld('anzioShell', {
+    available: true,
+    // 拖进编辑区的文件要拿到本机真实路径才能当标签打开：Electron 32 起 File.path 已移除，
+    // 唯一的替代 webUtils.getPathForFile 必须在 preload 里拿着 File 对象调用。
+    getFilePath: (file: File) => {
+      try { return webUtils.getPathForFile(file) || '' } catch { return '' }
+    },
+    // 标签右键菜单：在文件资源管理器中显示（handler 见 tiangong-ipc.ts）
+    revealInFolder: (path: string) => ipcRenderer.invoke('anzio-shell:reveal', String(path || '')),
+    // 打开文件 / 另存为 / 选目录：平台只给了 pickDirectory，选文件与保存必须由壳补（对齐 VSCode 原生对话框）
+    pickFile: () => ipcRenderer.invoke('anzio-shell:pick-file'),
+    pickSavePath: (defaultPath: string) => ipcRenderer.invoke('anzio-shell:pick-save', String(defaultPath || '')),
+    pickDirectory: () => ipcRenderer.invoke('anzio-shell:pick-dir'),
+    // 本机密文：落盘前交给壳用 safeStorage（Windows DPAPI）加密，文件里只有密文
+    secretSet: (key: string, value: string) => ipcRenderer.invoke('anzio-shell:secret-set', String(key || ''), String(value || '')),
+    secretGet: (key: string) => ipcRenderer.invoke('anzio-shell:secret-get', String(key || '')),
+    secretDel: (key: string) => ipcRenderer.invoke('anzio-shell:secret-del', String(key || '')),
+    // 天工快捷键最高优先：页面把键位表交上来，壳只在窗口有焦点时注册成全局快捷键
+    setHotkeys: (chords: string[]) => ipcRenderer.invoke('anzio-shell:hotkeys', Array.isArray(chords) ? chords : []),
+    onHotkey: (callback: (chord: string) => void) => {
+      const handler = (_event: Electron.IpcRendererEvent, chord: unknown): void => { try { callback(String(chord || '')) } catch { /* 忽略 */ } }
+      ipcRenderer.on('anzio-shell:hotkey', handler)
+      return () => { try { ipcRenderer.removeListener('anzio-shell:hotkey', handler) } catch { /* 忽略 */ } }
+    },
+    browser: {
+      available: true,
+      create: (id: string, url: string) => ipcRenderer.invoke('anzio-browser:create', String(id || ''), String(url || '')),
+      destroy: (id: string) => ipcRenderer.invoke('anzio-browser:destroy', String(id || '')),
+      setBounds: (id: string, rect: unknown) => ipcRenderer.invoke('anzio-browser:bounds', String(id || ''), rect || null),
+      setVisible: (id: string, visible: boolean) => ipcRenderer.invoke('anzio-browser:visible', String(id || ''), !!visible),
+      focus: (id: string) => ipcRenderer.invoke('anzio-browser:focus', String(id || '')),
+      blur: () => ipcRenderer.invoke('anzio-browser:blur'),
+      navigate: (id: string, url: string) => ipcRenderer.invoke('anzio-browser:navigate', String(id || ''), String(url || '')),
+      action: (id: string, action: string) => ipcRenderer.invoke('anzio-browser:action', String(id || ''), String(action || '')),
+      openExternal: (url: string) => ipcRenderer.invoke('anzio-browser:open-external', String(url || '')),
+      info: (id: string) => ipcRenderer.invoke('anzio-browser:info', String(id || '')),
+      reset: () => ipcRenderer.invoke('anzio-browser:reset'),
+      onEvent: (callback: (event: unknown) => void) => {
+        const handler = (_event: Electron.IpcRendererEvent, payload: unknown): void => { try { callback(payload) } catch { /* 页面自己抛的不管 */ } }
+        ipcRenderer.on('anzio-browser:event', handler)
+        return () => { try { ipcRenderer.removeListener('anzio-browser:event', handler) } catch { /* 忽略 */ } }
+      },
+      setPhantom: (options: unknown) => ipcRenderer.invoke('anzio-browser:phantom', options || {}),
+      phantomState: () => ipcRenderer.invoke('anzio-browser:phantom-state'),
+      onBrowserAction: (callback: (record: unknown) => void) => {
+        const handler = (_event: Electron.IpcRendererEvent, payload: unknown): void => { try { callback(payload) } catch { /* 忽略 */ } }
+        ipcRenderer.on('anzio-browser:agent-action', handler)
+        return () => { try { ipcRenderer.removeListener('anzio-browser:agent-action', handler) } catch { /* 忽略 */ } }
+      },
+      onBrowserKey: (callback: (payload: unknown) => void) => {
+        const handler = (_event: Electron.IpcRendererEvent, payload: unknown): void => { try { callback(payload) } catch { /* 忽略 */ } }
+        ipcRenderer.on('anzio-browser:key', handler)
+        return () => { try { ipcRenderer.removeListener('anzio-browser:key', handler) } catch { /* 忽略 */ } }
+      },
+    },
+  })
+}
diff --git a/apps/desktop/src/tiangong-profile.ts b/apps/desktop/src/tiangong-profile.ts
new file mode 100644
index 0000000000..5ca111d88f
--- /dev/null
+++ b/apps/desktop/src/tiangong-profile.ts
@@ -0,0 +1,71 @@
+/**
+ * 天工家目录种子（自研，官方源码只在 main.ts 的调用点接入）。
+ *
+ * 为什么需要它：安装版的 profile 是官方现建的空白 profile（只有官方几个 bundle），
+ * 里面既没有天工插件也没有天工的装配单 ⇒ 装完打开是官方原样界面，三栏外壳不出现。
+ * 这里在**任何后端启动之前**把两样东西种进去：
+ *
+ *   1. 插件：`<resources>\tiangong\plugin` → `<profile>\node_modules\dsh-ide`
+ *      （官方 profile 是 hoisted 扁平布局、且引擎按模块名解析插件 ⇒ 实体目录就够，不跑包管理器）
+ *   2. 装配单：`<resources>\tiangong\home-files\profiles\desktop\cordis.patch.yml`
+ *      → `<profile>\cordis.patch.yml`，模板里的 `{{HOME}}` 替换成真实家目录
+ *
+ * 两条都是幂等的：插件目录已有 package.json 就跳过；装配单已含 `id: dsh-ide` 就跳过
+ * （用户自己改过的装配单不会被重写，覆盖前也会留 `.bak-tiangong`）。
+ * 开发模式下 `process.resourcesPath` 里没有 tiangong 资源，整个函数是空操作。
+ */
+
+import { cpSync, copyFileSync, existsSync, lstatSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+
+export function ensureTiangongProfile(options: {
+  /** 官方 profile 目录（`$DSH_HOME/profiles/desktop`）。 */
+  profile: string
+  /** 安装包的 resources 目录（开发模式下没有天工资源，函数自动跳过）。 */
+  resources: string
+  log: (message: string) => void
+}): void {
+  const log = options.log
+  const home = dirname(dirname(options.profile))
+  // 凭证种子（2026-11-24）：绿色版/新机器把 credentials.yaml 放在 exe 旁边，首启拷进家目录。
+  // 家目录已有凭证就不动（不覆盖用户自己填的）。凭证是明文 YAML、不绑机器，拷过去即可用；
+  // 但它是账号 Key —— 打包分发时不要默认带上，由用的人自己放。
+  const credentialSource = join(dirname(process.execPath), 'credentials.yaml')
+  const credentialTarget = join(home, '.credentials.yaml')
+  if (existsSync(credentialSource) && !existsSync(credentialTarget)) {
+    mkdirSync(home, { recursive: true })
+    copyFileSync(credentialSource, credentialTarget)
+    log('[tiangong][profile] 已从安装目录导入凭证')
+  }
+  const pluginSource = join(options.resources, 'tiangong', 'plugin')
+  const pluginTarget = join(options.profile, 'node_modules', 'dsh-ide')
+  if (existsSync(join(pluginSource, 'package.json'))) {
+    // 「有效」= 目录里有 package.json **且不是符号链接**。开发机迁过来的 profile 里
+    // node_modules\dsh-ide 常是指向检出目录的链接，换机就断 —— 这种一律换成包里的实体副本。
+    let valid = existsSync(join(pluginTarget, 'package.json'))
+    if (valid) {
+      try { valid = !lstatSync(pluginTarget).isSymbolicLink() } catch { valid = false }
+    }
+    if (!valid) {
+      rmSync(pluginTarget, { recursive: true, force: true })
+      mkdirSync(dirname(pluginTarget), { recursive: true })
+      cpSync(pluginSource, pluginTarget, { recursive: true })
+      log(`[tiangong][profile] 插件已装入 ${pluginTarget}`)
+    }
+  }
+
+  const templatePath = join(options.resources, 'tiangong', 'home-files', 'profiles', 'desktop', 'cordis.patch.yml')
+  if (!existsSync(templatePath)) {
+    log('[tiangong][profile] 安装包里没有装配单模板，跳过（开发模式属正常）')
+    return
+  }
+  const patchPath = join(options.profile, 'cordis.patch.yml')
+  const existing = existsSync(patchPath) ? readFileSync(patchPath, 'utf8') : ''
+  if (existing.includes('id: dsh-ide')) {
+    log('[tiangong][profile] 装配单已含 dsh-ide，保持原样')
+    return
+  }
+  if (existing !== '') copyFileSync(patchPath, `${patchPath}.bak-tiangong`)
+  writeFileSync(patchPath, readFileSync(templatePath, 'utf8').split('{{HOME}}').join(home), 'utf8')
+  log(`[tiangong][profile] 装配单已落 ${patchPath}`)
+}
diff --git a/apps/desktop/src/tiangong-shell.ts b/apps/desktop/src/tiangong-shell.ts
new file mode 100644
index 0000000000..3cb2cc61e8
--- /dev/null
+++ b/apps/desktop/src/tiangong-shell.ts
@@ -0,0 +1,135 @@
+/**
+ * 天工壳桥接入层（自研，独立目录；官方源码只在本文件被 import 那一行与其调用点处接入）。
+ *
+ * 为什么需要它：天工插件内置浏览器那套（browser_* 工具、幻影、17 个工具）跑在后端子进程里，
+ * 它必须通过「壳桥」指挥 Electron 主进程里的 WebContentsView。壳桥的地址与口令历来是
+ * **壳起后端时用环境变量塞下去**的（ANZIO_BROWSER_BRIDGE / ANZIO_BROWSER_TOKEN）。
+ * 官方桌面壳起后端的代码路径不同，没人塞这两项 ⇒ 插件只能报「当前进程没有壳桥」。
+ * 这里按天工旧壳的顺序把三件挂好，再把地址与口令写回 process.env —— 官方起后端时
+ * 会完整继承 process.env（apps/desktop/src/node-environment.ts），因此不需要第二次接入。
+ */
+
+import { createRequire } from 'node:module'
+import { join } from 'node:path'
+import { app, type BrowserWindow } from 'electron'
+
+const requireShell = createRequire(import.meta.url)
+
+/**
+ * 天工壳半源码目录。打包后取 `resources/tiangong-shell`（electron-builder 的 extraResources 放进去的，
+ * 见 scripts/electron-builder-config.mjs 的接入点⑪）；开发期指本机检出；两者都可用 TIANGONG_SHELL_DIR 覆盖。
+ */
+export const SHELL_DIRECTORY = process.env.TIANGONG_SHELL_DIR
+  ?? (app.isPackaged
+    ? join(process.resourcesPath, 'tiangong-shell')
+    : 'D:\\99DSH\\deepseek-harness-mine\\shell')
+
+/** 调试端口：优先用命令行已给的（开发模式官方会带 9222），否则退回天工的 9333。 */
+function browserDebugPort(): number {
+  const argument = process.argv.find(item => item.startsWith('--remote-debugging-port'))
+  const configured = argument === undefined
+    ? Number(process.env.ANZIO_BROWSER_DEBUG_PORT ?? '9333')
+    : Number(argument.split('=')[1])
+  return Number.isSafeInteger(configured) && configured > 0 && configured < 65_536 ? configured : 9333
+}
+
+export interface TiangongShellHandle {
+  readonly bridgeUrl: string
+  close(): void
+}
+
+interface TiangongBrowserHost {
+  phantom?: () => { on?: boolean }
+  sendToView?: (id: string, command: unknown) => number
+  sendAction?: (record: unknown) => void
+  reapplyIdentity?: () => void
+  [key: string]: unknown
+}
+
+interface TiangongDriver {
+  isConnected?: () => boolean
+  patchIdentityById?: (id: string) => void
+  close?: () => void | Promise<void>
+  [key: string]: unknown
+}
+
+interface TiangongBridge {
+  url: string
+  token: string
+  close?: () => void
+}
+
+/**
+ * 把内置浏览器宿主、Playwright 驱动层与壳桥挂到当前桌面壳上。
+ * 失败不抛给调用方：壳桥起不来时天工其余功能照常，只是 Agent 不能指挥浏览器。
+ */
+export async function installTiangongShell(options: {
+  window: BrowserWindow
+  log: (message: string) => void
+}): Promise<TiangongShellHandle | undefined> {
+  const log = options.log
+  let driver: TiangongDriver | undefined
+  try {
+    const browser = requireShell(join(SHELL_DIRECTORY, 'browser.js')) as {
+      installBrowserHost: (win: BrowserWindow, note: (message: string, meta?: unknown) => void, extra: Record<string, unknown>) => TiangongBrowserHost
+      CHROME_UA: string
+      CHROME_UA_METADATA: string
+    }
+    const driverModule = requireShell(join(SHELL_DIRECTORY, 'driver.js')) as {
+      createDriver: (options: Record<string, unknown>) => TiangongDriver
+    }
+    const bridgeModule = requireShell(join(SHELL_DIRECTORY, 'bridge.js')) as {
+      startBridge: (options: Record<string, unknown>) => Promise<TiangongBridge>
+    }
+
+    const host = browser.installBrowserHost(options.window, (message, meta) => {
+      log(`[tiangong][browser-host] ${message}${meta === undefined ? '' : ` ${JSON.stringify(meta)}`}`)
+    }, {
+      driverConnected: () => driver?.isConnected?.() === true,
+      requestIdentityPatch: (id: string) => {
+        try { driver?.patchIdentityById?.(id) } catch { /* 驱动层没装就跳过 */ }
+      },
+    })
+
+    driver = driverModule.createDriver({
+      port: browserDebugPort(),
+      onLog: (message: string, meta?: unknown) => {
+        log(`[tiangong][driver] ${message}${meta === undefined ? '' : ` ${JSON.stringify(meta)}`}`)
+      },
+      phantom: {
+        enabled: () => host.phantom?.().on === true,
+        send: (id: string, command: unknown) => host.sendToView?.(id, command) ?? 0,
+      },
+      onAction: (record: unknown) => { host.sendAction?.(record) },
+      chromeIdentity: { ua: browser.CHROME_UA, platform: 'Win32', metadata: browser.CHROME_UA_METADATA },
+      onDisconnect: () => {
+        try { host.reapplyIdentity?.() } catch { /* 退出流程里不用管 */ }
+      },
+    })
+
+    const bridge = await bridgeModule.startBridge({
+      driver,
+      host,
+      win: options.window,
+      log: (message: string, meta?: unknown) => {
+        if (message === 'bridge-call') return
+        log(`[tiangong][bridge] ${message}${meta === undefined ? '' : ` ${JSON.stringify(meta)}`}`)
+      },
+    })
+
+    process.env.ANZIO_BROWSER_BRIDGE = bridge.url
+    process.env.ANZIO_BROWSER_TOKEN = bridge.token
+    log(`[tiangong][bridge] listening ${bridge.url}`)
+
+    return {
+      bridgeUrl: bridge.url,
+      close: () => {
+        try { bridge.close?.() } catch { /* 已关闭 */ }
+        try { void driver?.close?.() } catch { /* 已关闭 */ }
+      },
+    }
+  } catch (error) {
+    log(`[tiangong][bridge] 壳桥启动失败（Agent 将无法指挥内置浏览器）：${error instanceof Error ? error.stack ?? error.message : String(error)}`)
+    return undefined
+  }
+}
diff --git a/apps/desktop/src/tiangong-updater.ts b/apps/desktop/src/tiangong-updater.ts
new file mode 100644
index 0000000000..3c6083ca08
--- /dev/null
+++ b/apps/desktop/src/tiangong-updater.ts
@@ -0,0 +1,141 @@
+/**
+ * 天工更新器接入（自研，官方源码只在 main.ts 的调用点接入）。
+ *
+ * 更新器本体是 `-mine\shell\updater.js`（CJS，与旧壳同一份，一行不改）：
+ * 更新源目录里的 `latest.json` 描述版本与逐文件 sha256，比已装基线变化的文件才进包；
+ * 下载校验后落 `_staging`，**下次启动的最开头**替换文件（那时没有旧实例占用）。
+ *
+ * 只更新「asar 之外」的东西 —— 壳半 4 个 JS、插件、家目录种子、home-files：
+ * `resources/tiangong-shell`、`resources/tiangong`、`<家目录>\profiles\desktop\node_modules\dsh-ide`。
+ * 官方内核（Electron / app.asar / dsh 运行时）换个版本才动，走整包重装，不进增量链路
+ * （asar 被运行中的进程锁着，本来就替换不了）。
+ *
+ * 开发模式整个不启用：没有安装目录与 version.json，启用只会读到假状态。
+ */
+
+import { createRequire } from 'node:module'
+import { app, dialog, ipcMain, type BrowserWindow } from 'electron'
+import { dirname, join } from 'node:path'
+
+const requireShell = createRequire(import.meta.url)
+
+interface UpdaterState {
+  phase: string
+  installed: string
+  latest: { version?: string; notes?: string; fileCount?: number; totalBytes?: number } | null
+  error: string | null
+  progress: number
+  checkedAt: number
+}
+
+interface CheckResult { ok: boolean; available: boolean; installed: string; latest?: unknown; error?: string }
+
+export interface TiangongUpdater {
+  readonly state: UpdaterState
+  check(): Promise<CheckResult>
+  install(): Promise<unknown>
+  applyAndRestart(): unknown
+  applyPending(): { applied: boolean; version?: string; failures?: string[]; relaunch?: boolean }
+  config(): { feed: string; autoCheck: boolean; autoApply: boolean; checkIntervalMs: number }
+  skippedVersion(): string
+  skipVersion(version: string): void
+  failedRecently(version: string): boolean
+  markFailed(version: string, error: string): void
+}
+
+let instance: TiangongUpdater | undefined
+let handlersInstalled = false
+/** 主窗口：状态变化要推给页面（插件的标题栏徽标靠 anzioUpdater.onState 订阅）。 */
+let targetWindow: BrowserWindow | undefined
+
+function createUpdater(shellDirectory: string, home: string, log: (message: string) => void): TiangongUpdater | undefined {
+  if (!app.isPackaged) return undefined
+  try {
+    const { Updater } = requireShell(join(shellDirectory, 'updater.js')) as {
+      Updater: new (options: unknown) => TiangongUpdater
+    }
+    return new Updater({
+      installDir: dirname(process.execPath),
+      homeDir: home,
+      exePath: process.execPath,
+      onState: (state: UpdaterState) => {
+        log(`[tiangong][updater] ${state.phase}${state.error === null ? '' : ' :: ' + state.error}`)
+        try {
+          if (targetWindow !== undefined && !targetWindow.isDestroyed()) targetWindow.webContents.send('anzio-updater:state', state)
+        } catch { /* 窗口关闭中 */ }
+      },
+    })
+  } catch (error) {
+    log(`[tiangong][updater] 初始化失败：${error instanceof Error ? error.message : String(error)}`)
+    return undefined
+  }
+}
+
+/**
+ * 建更新器实例并注册页面 IPC（只注册一次）。
+ * @param options - 壳半目录（updater.js 所在）、天工家目录、日志出口。
+ * @returns 更新器实例；开发模式或初始化失败时为 undefined。
+ */
+export function installTiangongUpdater(options: {
+  shellDirectory: string
+  home: string
+  log: (message: string) => void
+  /** 主窗口；启动最早那次还没建窗口，窗口建好后再调一次把这个补上。 */
+  window?: BrowserWindow
+}): TiangongUpdater | undefined {
+  if (options.window !== undefined) targetWindow = options.window
+  if (instance === undefined) instance = createUpdater(options.shellDirectory, options.home, options.log)
+  const updater = instance
+  if (updater === undefined) return undefined
+  if (!handlersInstalled) {
+    handlersInstalled = true
+    ipcMain.handle('anzio-updater:state', () => updater.state)
+    ipcMain.handle('anzio-updater:check', async () => updater.check())
+    ipcMain.handle('anzio-updater:install', async () => updater.install())
+    ipcMain.handle('anzio-updater:apply', () => updater.applyAndRestart())
+  }
+  return updater
+}
+
+/**
+ * 启动后的一次更新检查（不阻塞界面）。发现新版弹一次原生询问，
+ * 用户点了才下载并重启；不想装就记下这个版本，下次启动不再打扰。
+ * @param updater - 更新器实例。
+ * @param window - 主窗口（对话框的父窗口）。
+ * @param log - 日志出口。
+ */
+export async function checkTiangongUpdate(updater: TiangongUpdater, window: BrowserWindow, log: (message: string) => void): Promise<void> {
+  const config = updater.config()
+  if (!config.autoCheck) return
+  const result = await updater.check()
+  if (!result.ok || !result.available) {
+    if (!result.ok) log(`[tiangong][updater] 检查失败：${String(result.error ?? '')}`)
+    return
+  }
+  const version = String(updater.state.latest?.version ?? '')
+  if (version === '' || version === updater.skippedVersion()) return
+  if (updater.failedRecently(version)) return
+
+  const choice = await dialog.showMessageBox(window, {
+    type: 'info',
+    title: '检测到新版本',
+    message: `天工有新版本 v${version}（当前 v${result.installed}）`,
+    detail: `${updater.state.latest?.notes ?? ''}\n\n下载完成后会立即重启并装上。`.trim(),
+    buttons: ['现在更新', '稍后'],
+    defaultId: 0,
+    cancelId: 1,
+    noLink: true,
+  })
+  if (choice.response !== 0) {
+    updater.skipVersion(version)
+    return
+  }
+  const installed = await updater.install() as { ok?: boolean; error?: string }
+  if (installed?.ok !== true) {
+    updater.markFailed(version, String(installed?.error ?? 'download-failed'))
+    log(`[tiangong][updater] 安装包下载失败：${String(installed?.error ?? '')}`)
+    await dialog.showMessageBox(window, { type: 'error', title: '更新失败', message: '下载或校验失败，已跳过本次更新。', detail: String(installed?.error ?? ''), buttons: ['好'], noLink: true })
+    return
+  }
+  updater.applyAndRestart()
+}
diff --git a/apps/desktop/src/windows-layout.ts b/apps/desktop/src/windows-layout.ts
index 0ba4ad5c7e..84d67999f2 100644
--- a/apps/desktop/src/windows-layout.ts
+++ b/apps/desktop/src/windows-layout.ts
@@ -1,4 +1,5 @@
 /** Shared geometry for the Windows main-window caption. */
 
 /** Windows application titlebar height in device-independent pixels. */
